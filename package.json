{
  "name": "fox-vpn",
  "productName": "Fox VPN",
  "version": "1.0.2",
  "description": "Independent VPN client built on Mozilla's Firefox VPN infrastructure",
  "author": "Erfan Tahvilian",
  "license": "GPL-3.0-or-later",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.cjs",
    "engine": "node scripts/download-engine.cjs",
    "dist": "node scripts/build-windows.cjs",
    "check": "node scripts/check.cjs",
    "smoke": "node scripts/smoke-runner.cjs",
    "engine:linux": "node scripts/download-linux-engine.cjs",
    "dist:linux": "node scripts/build-linux.cjs",
    "engine:mac": "node scripts/download-mac-engine.cjs",
    "dist:mac": "node scripts/build-mac.cjs"
  },
  "dependencies": {
    "socks": "2.8.10"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "flag-icons": "7.5.0"
  },
  "build": {
    "appId": "com.foxvpn.desktop",
    "productName": "Fox VPN",
    "artifactName": "FoxVPN-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "assets/**/*",
      "licenses/**/*",
      "LICENSE",
      "COPYRIGHT",
      "package.json",
      "release-notes.json"
    ],
    "extraResources": [
      {
        "from": "engine/${arch}",
        "to": "engine",
        "filter": [
          "sing-box.exe",
          "wintun.dll",
          "LICENSE*",
          "*.txt",
          "fox-h3.exe"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "installerLanguages": [
        "en_US"
      ],
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fox VPN",
      "include": "scripts/installer.nsh"
    }
  }
}
